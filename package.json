{
  "name": "kaily-widget-starter",
  "version": "1.0.0",
  "description": "Minimal starter for a custom Kaily chat widget with @kaily-ai/chat-sdk. Set your token, edit the UI, run `npm run deploy`.",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack.config.js",
    "dev": "webpack serve --config webpack.config.js",
    "build": "rm -rf dist && webpack --config webpack.config.js --env prod",
    "deploy": "npm run build && node deploy.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@kaily-ai/chat-sdk": "file:../Boltic/services/seraph",
    "preact": "^10.25.4",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-loader": "^8.2.2",
    "compression-webpack-plugin": "^10.0.0",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.11",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
